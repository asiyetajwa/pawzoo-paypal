# Copy to .env (same folder) and fill in. .env is git-ignored. npm start reads it, and its values win over any
# variable of the same name already set in your system. Everything here is optional: without it Pawzoo uses
# rules, templates, a local file and an offline PayPal stand-in that moves no money.

# PayPal sandbox app (developer.paypal.com, Apps & Credentials, Sandbox). Pawzoo runs against the sandbox only.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# Claude for the assistant and the evening digest. No model calls without a spending cap.
# ANTHROPIC_API_KEY=
# PAWZOO_BUDGET_USD=5
# PAWZOO_MODEL=claude-haiku-5-5

# Real cameras: a camera bridge posts signed webhooks to /camera/webhook (see server/src/camera.ts).
# CAMERA_WEBHOOK_SECRET=
# CAMERA_MAP={"porch-cam":"front-door","den-cam":"living-room"}

# ElevenLabs voice for spoken answers and the demo film's narration (Text to Speech permission).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
