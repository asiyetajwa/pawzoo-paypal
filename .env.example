# Copy to .env (same folder) and fill in. .env is git-ignored. npm start and npm run check:aws read it,
# and its values win over any variable of the same name already set in your system.
# us.amazon.nova-2-lite-v1:0 is a US cross-region inference profile: keep AWS_REGION a US region.
# PAWZOO_TABLE is the DynamoDB table name exactly as it appears in the console (partition key householdId, String).
# Everything here is optional: uncomment what you have. Without it Pawzoo uses rules, templates and a local file.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# PAWZOO_TABLE=PAWZOO_TABLE
# ElevenLabs voice for spoken answers and the demo film's narration (your key from elevenlabs.io,
# with the Text to Speech permission).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Credentials: leave these out if you use the AWS CLI's default profile (aws configure).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
