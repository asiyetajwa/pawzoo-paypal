{
  "name": "@pawzoo/server",
  "version": "1.0.0",
  "description": "Pawzoo: the MCP server, camera webhooks and PayPal payments",
  "scripts": {
    "dev": "npm run views && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run views && tsc -p .",
    "views": "node build-views.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run views && node --import tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@paypal/agent-toolkit": "^1.11.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "private": true,
  "type": "module"
}
