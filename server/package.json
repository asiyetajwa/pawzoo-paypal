{
  "name": "@pawzoo/server",
  "version": "1.0.0",
  "description": "Pawzoo: Alexa+ MCP server, Ring webhooks and Fire TV feed",
  "scripts": {
    "dev": "npm run views && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run views && tsc -p .",
    "views": "node build-views.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run views && node --import tsx --test test/*.test.ts",
    "check:aws": "tsx scripts/check-aws.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "private": true,
  "type": "module"
}
